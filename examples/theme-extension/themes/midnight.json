{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Midnight",
  "author": "Rustrest",
  "themes": [
    {
      "name": "Midnight",
      "appearance": "dark",
      "style": {
        "background": "#15171cff",
        "border": "#2a2e38ff",
        "border.variant": "#20232bff",
        "surface.background": "#181b21ff",
        "elevated_surface.background": "#1c1f26ff",
        "element.hover": "#232733ff",
        "element.selected": "#2c3140ff",
        "text": "#e0e4ecff",
        "text.muted": "#8a90a0ff",
        "text.accent": "#7aa2f7ff",
        "title_bar.background": "#15171cff",
        "status_bar.background": "#15171cff",
        "tab.active_background": "#101216ff",
        "tab.inactive_background": "#181b21ff",
        "editor.background": "#101216ff",
        "editor.foreground": "#c7ccd6ff",
        "terminal.background": "#101216ff",
        "terminal.foreground": "#c7ccd6ff",
        "terminal.ansi.black": "#15171cff",
        "terminal.ansi.red": "#f7768eff",
        "terminal.ansi.green": "#9ece6aff",
        "terminal.ansi.yellow": "#e0af68ff",
        "terminal.ansi.blue": "#7aa2f7ff",
        "terminal.ansi.magenta": "#bb9af7ff",
        "terminal.ansi.cyan": "#7dcfffff",
        "terminal.ansi.white": "#c7ccd6ff",
        "success": "#9ece6aff",
        "warning": "#e0af68ff",
        "error": "#f7768eff",
        "info": "#7aa2f7ff",
        "players": [{ "cursor": "#7aa2f7ff", "background": "#7aa2f7ff", "selection": "#7aa2f740" }],
        "syntax": {
          "comment": { "color": "#565f89ff", "font_style": "italic", "font_weight": null },
          "keyword": { "color": "#bb9af7ff", "font_style": null, "font_weight": null },
          "string": { "color": "#9ece6aff", "font_style": null, "font_weight": null },
          "number": { "color": "#ff9e64ff", "font_style": null, "font_weight": null },
          "boolean": { "color": "#ff9e64ff", "font_style": null, "font_weight": null },
          "function": { "color": "#7aa2f7ff", "font_style": null, "font_weight": null },
          "property": { "color": "#73dacaff", "font_style": null, "font_weight": null },
          "type": { "color": "#2ac3deff", "font_style": null, "font_weight": null },
          "operator": { "color": "#89ddffff", "font_style": null, "font_weight": null },
          "punctuation": { "color": "#a9b1d6ff", "font_style": null, "font_weight": null },
          "variable": { "color": "#c0caf5ff", "font_style": null, "font_weight": null }
        }
      }
    },
    {
      "name": "Midnight Light",
      "appearance": "light",
      "style": {
        "editor.background": "#f7f8faff",
        "text": "#1f2330ff",
        "text.muted": "#6b7285ff",
        "text.accent": "#2e5bd8ff",
        "surface.background": "#eceef3ff",
        "border": "#d3d7e0ff",
        "success": "#387a2cff",
        "warning": "#9a6a00ff",
        "error": "#c4344aff",
        "syntax": {
          "comment": { "color": "#8b91a3ff", "font_style": "italic", "font_weight": null },
          "keyword": { "color": "#7a3fc4ff", "font_style": null, "font_weight": null },
          "string": { "color": "#387a2cff", "font_style": null, "font_weight": null },
          "number": { "color": "#b35900ff", "font_style": null, "font_weight": null },
          "function": { "color": "#2e5bd8ff", "font_style": null, "font_weight": null }
        }
      }
    }
  ]
